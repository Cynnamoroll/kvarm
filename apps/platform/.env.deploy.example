# Deployment target for scripts/wrangler-target.mjs (npm run deploy,
# npm run db:migrate:remote). Copy to .env.deploy, which is gitignored.
# Variables set in the environment take precedence over this file.

# Required: the id printed by `npx wrangler d1 create <name>`.
KVARM_D1_DATABASE_ID=
# Required for deploys: the worker's public origin, without a trailing slash,
# e.g. https://<worker>.<your-subdomain>.workers.dev or a custom domain.
KVARM_APP_ORIGIN=
# Optional: the D1 database name when it differs from wrangler.jsonc.
# KVARM_D1_DATABASE_NAME=
# Optional: pin the Cloudflare account when your login can see several.
# CLOUDFLARE_ACCOUNT_ID=
