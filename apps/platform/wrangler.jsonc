{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kvarm-platform",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "default",
      "remote": true
    }
  ],
  // The database_id and vars.APP_ORIGIN are neutral placeholders. Remote
  // commands (npm run deploy, db:migrate:remote) go through
  // scripts/wrangler-target.mjs, which fills in your own values from
  // KVARM_D1_DATABASE_ID and KVARM_APP_ORIGIN (see .env.deploy.example).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kvarm",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SNAPSHOTS",
      "bucket_name": "kvarm-snapshots"
    }
  ],
  // The consumer's latency is the push-event path's latency (push -> guard,
  // train kick -> pass), so batches do not wait to fill: every message is
  // delivered as soon as it arrives (max_batch_timeout 0), in small batches
  // (each processed in order within one invocation) that the queue spreads
  // over concurrent invocations to drain bursts.
  "queues": {
    "producers": [
      {
        "binding": "EVENTS",
        "queue": "kvarm-events"
      }
    ],
    "consumers": [
      {
        "queue": "kvarm-events",
        "max_batch_size": 5,
        "max_batch_timeout": 0,
        "max_retries": 3,
        "dead_letter_queue": "kvarm-events-dlq"
      }
    ]
  },
  // Outbound webhooks: every minute, enqueue due deliveries whose message was
  // never sent or was lost, and prune the delivery log (services/webhooks.ts).
  "triggers": {
    "crons": ["* * * * *"]
  },
  // Workers Rate Limiting (per-colo counters). The RateLimiter Durable Object
  // stays exported for its migration but is no longer on any request path.
  "ratelimits": [
    { "name": "READ_LIMITER", "namespace_id": "4601", "simple": { "limit": 600, "period": 60 } },
    { "name": "WRITE_LIMITER", "namespace_id": "4602", "simple": { "limit": 120, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "TOKENS", "class_name": "TokenCache" },
      { "name": "RATE_LIMIT", "class_name": "RateLimiter" },
      { "name": "MERGE_LOCK", "class_name": "MergeLock" },
      { "name": "CI_SANDBOX", "class_name": "CiRunnerSandbox" },
      { "name": "ENV_BUILDER", "class_name": "EnvironmentBuilder" },
      { "name": "AGENT_SANDBOX", "class_name": "AgentSandbox" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TokenCache", "RateLimiter", "RealtimeHub", "MergeLock"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["CiRunnerSandbox"]
    },
    {
      "tag": "v3",
      "deleted_classes": ["RealtimeHub"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["EnvironmentBuilder", "AgentSandbox"]
    }
  ],
  // Container CI runner showcase (public beta). No image or dockerfile key:
  // the Cloudflare-managed cloudflare/debian-trixie image is chosen at
  // ctx.container.start(), which only the durable_object policy allows.
  "containers": [
    {
      "class_name": "CiRunnerSandbox",
      "scheduling_policy": "durable_object"
    },
    {
      "class_name": "EnvironmentBuilder",
      "scheduling_policy": "durable_object"
    },
    {
      "class_name": "AgentSandbox",
      "scheduling_policy": "durable_object"
    }
  ],
  "workflows": [
    { "name": "snapshot-builder", "binding": "SNAPSHOT_BUILDER", "class_name": "SnapshotBuilder" },
    { "name": "ci-pipeline", "binding": "CI_PIPELINE", "class_name": "CiPipeline" },
    { "name": "merge", "binding": "MERGE_WORKFLOW", "class_name": "MergeWorkflow" },
    { "name": "repo-import", "binding": "REPO_IMPORT", "class_name": "RepoImport" },
    { "name": "environment-build", "binding": "ENVIRONMENT_BUILD", "class_name": "EnvironmentBuild" }
  ],
  "triggers": {
    "crons": ["0 */6 * * *"]
  },
  "vars": {
    "SITE_NAME": "Kvarm",
    "APP_ORIGIN": "http://localhost:8787",
    "ARTIFACTS_NAMESPACE": "default",
    "WORKOS_REDIRECT_URI": "http://localhost:8787/auth/callback"
  },
  "observability": {
    "enabled": true
  },
  "placement": {
    "mode": "smart"
  }
}
