    "@kvarm/zstd": "*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "hono": "^4.6.0",
    "markdown-it": "^15.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.7",
    "@cloudflare/workers-types": "^5.20261007.0",
    "@types/markdown-it": "^14.2.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.148.0"
  }
